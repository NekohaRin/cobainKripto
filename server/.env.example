
# ==================================
# DATABASE - TiDB CLOUD
# ==================================
DB_HOST=your-tidb-host
DB_USER=your-tidb-username
DB_PASS=your-tidb-password
DB_NAME=evoting
DB_PORT=4000
DB_SSL=true

# ==================================
# SERVER
# ==================================
PORT=3000
NODE_ENV=production

# ==================================
# CRYPTOGRAPHY SECRETS
# ==================================
ADMIN_KEY=replace_with_strong_admin_key
ELECTION_SECRET=replace_with_random_secret
NIK_SALT=replace_with_random_salt
FACE_KEY=replace_with_random_face_key

# ==================================
# CLASSICAL ENCRYPTION
# ==================================
ELECTION_SHIFT=7
ELECTION_RAILS=4
BLOCK_SIZE=3

# ==================================
# BIOMETRIC
# ==================================
FACE_THRESHOLD=0.30

# ==================================
# BLOCKCHAIN / DEMO
# ==================================
ALLOW_TAMPER_DEMO=false

# ==================================
# USB DONGLE
# TETAP AKTIF
# ==================================
DONGLE_REQUIRED=true
ADMIN_DONGLE_HASH=replace_with_hash
DONGLE_TIMEOUT_MS=8000

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=evoting
DB_PORT=3306
DB_SSL=false
PORT=3000

ADMIN_KEY=change_me
ELECTION_SECRET=change_me
NIK_SALT=change_me
FACE_KEY=change_me

ELECTION_SHIFT=7
ELECTION_RAIL=4
BLOCK_SIZE=3

FACE_THRESHOLD=0.30
ALLOW_TAMPER_DEMO=false

NODE_ENV=development

# Dongle flashdisk (dicek di browser lewat berkas .key; server boleh di-host)
DONGLE_REQUIRED=true
# hash token dongle panitia, hasil: node make-admin-dongle.js E:\admin-dongle.key
ADMIN_DONGLE_HASH=replace_with_hash
# sesi dicabut jika bukti dongle tidak masuk selama batas ini (ms)
DONGLE_TIMEOUT_MS=8000
